# Copy to `.env` and fill in. The .env is git-ignored.

# ---- Which backend answers each exploration step --------------------------
# "gemini" (default) or "groq". Switch to groq if Gemini's daily free quota is
# spent — Groq's free tier is much more generous and also has a vision model.
# LLM_PROVIDER=gemini

# ---- Gemini (default) — free key: https://aistudio.google.com/apikey ------
GEMINI_API_KEY=your-key-here
# Defaults to gemini-2.5-flash-lite (the model with free-tier quota on most
# projects; others often show a limit-0 free quota). Override if needed.
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Groq (alternative) — free key: https://console.groq.com/keys ---------
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Tier 2: which coding agent applies a fix -----------------------------
# "prompt" (default) writes a portable fix prompt and touches no source — works
# for everyone. Set one of the others to let that agent apply and grade a fix:
#   claude | codex | copilot | command
# FIX_BACKEND=prompt
#
# For FIX_BACKEND=command, give a shell template. Placeholders {cwd},
# {prompt_file} and {prompt} are substituted before it runs, e.g.:
# FIX_CMD=my-agent --repo {cwd} --prompt-file {prompt_file}
