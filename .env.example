# Copy to `.env` and fill in. The .env is git-ignored.

# ---- Which backend answers each exploration step --------------------------
# "gemini" (default), "groq", or "local". Switch to groq if Gemini's daily free
# quota is spent — Groq's free tier is much more generous and also has a vision
# model. Use "local" on a GPU machine to drop the quota question entirely.
# LLM_PROVIDER=gemini

# ---- Local vision model (no quota, nothing leaves the machine) ------------
# Served by vLLM; see compose.yml and docs/LAB_SETUP.md. The compose
# stack sets these for you, so they only need setting when running the engine
# outside the container against a server elsewhere.
# LLM_PROVIDER=local
# LOCAL_BASE_URL=http://localhost:8000/v1
# LOCAL_MODEL=gremlin-vision
# LOCAL_API_KEY=only-if-your-server-requires-one
#
# Which checkpoint the vllm service loads. The 8B fits comfortably on a 32 GB
# card and is the right first target; see docs/LAB_SETUP.md before moving to a
# 32B, which needs quantisation to fit at all.
# VLLM_MODEL=Qwen/Qwen3-VL-8B-Instruct
# VLLM_MAX_LEN=16384
# VLLM_GPU_FRAC=0.90
# HF_TOKEN=only-needed-for-gated-checkpoints

# ---- Gemini — free key: https://aistudio.google.com/apikey ----------------
# Commented out on purpose. Left live, a placeholder key shows up as a real
# setting in every copied .env, which is misleading on a local-only install
# where no hosted backend is ever called. Uncomment only if you set
# LLM_PROVIDER=gemini.
# GEMINI_API_KEY=your-key-here
# Defaults to gemini-2.5-flash-lite (the model with free-tier quota on most
# projects; others often show a limit-0 free quota). Override if needed.
# GEMINI_MODEL=gemini-2.5-flash-lite

# ---- Groq (alternative) — free key: https://console.groq.com/keys ---------
# GROQ_API_KEY=your-groq-key-here
# GROQ_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# ---- Tier 2: which coding agent applies a fix -----------------------------
# "prompt" (default) writes a portable fix prompt and touches no source — works
# for everyone. Set one of the others to let that agent apply and grade a fix:
#   claude | codex | copilot | command
# FIX_BACKEND=prompt
#
# For FIX_BACKEND=command, give a shell template. Placeholders {cwd},
# {prompt_file} and {prompt} are substituted before it runs, e.g.:
# FIX_CMD=my-agent --repo {cwd} --prompt-file {prompt_file}
